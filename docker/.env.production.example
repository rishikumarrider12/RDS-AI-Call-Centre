NODE_ENV=production
PORT=3000

# API
API_PORT=4000
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=<SECRET_3fbb7ddc>vice-role-key

# Public Supabase keys for Realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SECRET_3fbb7ddc>on-key

# Auth Cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Redis
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=warn

# Production secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# Database (self-hosted Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SECRET_d7c98e7d>word
POSTGRES_DB=rds_call_centre

# Optional observability
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/traces
