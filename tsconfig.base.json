{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@rds/ui": ["./packages/ui/src"],
      "@rds/types": ["./packages/types/src"],
      "@rds/utils": ["./packages/utils/src"],
      "@rds/config": ["./packages/config/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
